# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.env

# Testing / tooling
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# MLflow (local backends)
mlruns/
mlartifacts/
mlflow.db

# Data & models are versioned with DVC, not Git
/data/raw/*
!/data/raw/.gitkeep
# data/processed and models/ are DVC pipeline outputs -> nothing under them may be
# tracked by Git (not even .gitkeep), or `dvc repro` fails.
/data/processed
/models
*.pt
*.h5
*.pkl

# Generated metrics / reports
/metrics/
/assets/*.jpg

# DVC local remote (blob store) and cache
/.dvcstore/
/.dvc/cache/
/mlartifacts_export/
/dist/

# OS
.DS_Store
