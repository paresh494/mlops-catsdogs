# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.env

# Testing / tooling
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# MLflow (local backends)
mlruns/
mlartifacts/
