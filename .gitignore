# Data & models are versioned with DVC, not Git
/data/raw/*
!/data/raw/.gitkeep
/data/processed/*
!/data/processed/.gitkeep
/models/*
!/models/.gitkeep
*.pt
*.h5
*.pkl

# Generated metrics / reports
/metrics/
/assets/*.jpg

# DVC local remote (blob store) and cache
/.dvcstore/
/.dvc/cache/
/mlartifacts_export/
/dist/

# OS
.DS_Store
