# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.env

# Testing / tooling
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# MLflow (local backends)
mlruns/
mlartifacts/
mlflow.db

# Data & models are versioned with DVC, not Git
/data/raw/*
!/data/raw/.gitkeep
# data/processed is a DVC pipeline output (whole dir) -> nothing under it may be
# tracked by Git, not even .gitkeep, or `dvc repro` fails.
/data/processed
# models/: the dir is kept (Dockerfile COPYs it) but its contents are ignored.
# The DVC output is the file models/model.pt, so a tracked .gitkeep is fine.
/models/*
!/models/.gitkeep
*.pt
*.h5
*.pkl

# Generated metrics / reports
/metrics/
/assets/*.jpg

# DVC local remote (blob store) and cache
/.dvcstore/
/.dvc/cache/
/mlartifacts_export/
/dist/

# OS
.DS_Store
